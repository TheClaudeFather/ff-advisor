# Sleeper Fantasy Advisor configuration.
# Copy to ~/.sleeper/.env and fill in your Sleeper handle, then run:
#   sleeper leagues
# That command discovers your leagues and writes the remaining keys for you.
#
# Lookup order, first hit wins:
#   1. the real process environment
#   2. $SLEEPER_ENV_FILE
#   3. $SLEEPER_HOME/.env      (default ~/.sleeper/.env)
#   4. .env at the plugin root (development only)

# Your Sleeper username. The only value you must set by hand.
SLEEPER_USERNAME=

# Filled in by `sleeper leagues`. Safe to leave empty.
SLEEPER_USER_ID=
SLEEPER_SEASON=

# alias:league_id pairs, comma separated. Written by `sleeper leagues`.
SLEEPER_LEAGUES=

# Which alias is used when you name no league.
SLEEPER_DEFAULT_LEAGUE=

# Your draft slot per league, as alias:slot pairs. Set this before a draft.
# Sleeper does not publish draft_order until the draft starts, and a wrong slot
# breaks all pick math.
SLEEPER_SLOTS=

# Where the cache, this .env file, and your notes live. Default ~/.sleeper
# SLEEPER_HOME=

# Optional file of private league notes the skill reads before advising.
# Default $SLEEPER_HOME/notes.md
# SLEEPER_NOTES=
